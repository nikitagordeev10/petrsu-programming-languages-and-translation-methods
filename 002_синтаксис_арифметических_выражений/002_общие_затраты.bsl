Процедура ПриНачалеРаботыСистемы()   
	ПостоянныеЗатраты = 100000;
	ПеременныеЗатраты = 5000;
	ОбъемПродукции = 50;
	
	// правильно
	ОбщиеЗатраты = ПостоянныеЗатраты + ПеременныеЗатраты * ОбъемПродукции;
	Сообщить(ОбщиеЗатраты);

	// правильно
	ОбщиеЗатраты = ПостоянныеЗатраты + (ПеременныеЗатраты * ОбъемПродукции);
	Сообщить(ОбщиеЗатраты);

	// не правильно
	ОбщиеЗатраты = (ПостоянныеЗатраты + ПеременныеЗатраты) * ОбъемПродукции;
	Сообщить(ОбщиеЗатраты);

КонецПроцедуры;