Процедура ПриНачалеРаботыСистемы()   
	КоличествоТовара = 2;
	ЦенаТовара = 10000;
	СуммаСкидки = 1000;
	КоличествоБонусов = 500;
	СтоимостьБонуса = 1;
	КоличествоМесяцевРассрочки = 12;
	
	ЕжемесячныйПлатеж = (КоличествоТовара * (ЦенаТовара - СуммаСкидки) - КоличествоБонусов * СтоимостьБонуса) / КоличествоМесяцевРассрочки;
	Сообщить(ЕжемесячныйПлатеж);
